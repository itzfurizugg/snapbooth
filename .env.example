# Public site origin; dipakai API untuk membuat URL QR absolut
VITE_PUBLIC_URL=https://your-app.vercel.app

# Server only: jangan gunakan prefix VITE_ untuk secret berikut
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Atau gunakan tiga variable ini:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=